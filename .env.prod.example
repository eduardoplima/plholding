# Copie para .env (NÃO comitar) e preencha com segredos fortes.
# Gere senhas/segredos com: openssl rand -hex 32

# Onde ficam os dados na MÁQUINA (Postgres e documentos). Em prod use /opt/plholding
DATA_DIR=/opt/plholding

# Domínio público (Caddy emite o certificado para ele)
APP_DOMAIN=app.holdingpl.com.br

# Segredos (OBRIGATÓRIOS)
POSTGRES_PASSWORD=troque-isto
JWT_SECRET=troque-isto

# Admin inicial (troque a senha no 1º login)
ADMIN_USERNAME=eduardo
ADMIN_PASSWORD=troque-isto

# CORS: mesma origem via Caddy, então pode restringir ao domínio
CORS_ORIGINS=https://app.holdingpl.com.br
